# name: follow_ball
# description: follow the ball at a safe distance without pushing it
# triggers: follow the ball, follow ball, chase the ball, trail the ball, tail the ball, keep near the ball
# plan: locate the ball (scan)@SCAN_FOR | trail it at a safe distance@FOLLOW
#
# Like follow_human but targeting the ball: trails the closest ball at a small
# standoff, AVOIDING obstacles (move mode, NOT push) — it keeps near the ball
# and never drives into it. Rotates to find the ball first, then follows.

SET ball = SCAN_FOR("ball", 360)
IF ball != NONE THEN
    PRINT "Found the ball — following it (not pushing)."
    SET r = FOLLOW("ball", 0.7)
    PRINT "Stopped following the ball."
ELSE
    PRINT "No ball found in the room."
END
