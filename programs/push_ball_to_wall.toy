# name: push_ball_to_wall
# description: find the ball and push it to the wall
# triggers: push the ball to the wall, push the ball, move the ball to the wall, ball to the wall, clear the ball away
# plan: locate the ball (scan)@SCAN_FOR | look again to lock it@FIND | approach & push the ball@PUSH_AWAY | finish push to the wall@PUSH_THROUGH
#
# Strategy (v3): rotate to FIND the ball (SCAN_FOR) — which puts the robot
# behind it automatically — then shove it straight AWAY from the robot
# (PUSH_AWAY) in bounded steps until it pins against a wall (stall). No fixed
# goal, no manual positioning: just drop the ball between the robot and the
# target wall and run.

SET push_seg = 0.40

# 1. Rotate slowly; stop the instant a ball comes into view.
SET ball = SCAN_FOR("ball", 360)

IF ball != NONE THEN
    # stop ~1s and locate the ball again for a clean, settled fix before pushing
    PRINT "Found the ball — stopping to locate it again."
    WAIT(1.0)
    SET fresh = FIND("ball")
    IF fresh == NONE THEN
        SET fresh = FIND("apple")
    END
    IF fresh != NONE THEN
        SET ball = fresh
    END
    PRINT "Pushing it to the wall."
    SET bx = ball.x
    SET by = ball.y
    SET done = NONE
    SET tries = 0
    WHILE done == NONE AND tries < 14 DO
        SET tries = tries + 1
        # 2. shove the ball straight away from the robot
        SET r = PUSH_AWAY(bx, by, push_seg)
        IF r == "stalled" THEN
            PRINT "ball pinned against the wall — done!"
            SET done = 1
        ELSE
            # 3. re-acquire WITHOUT rotating away — the ball is still ahead of us
            WAIT(0.3)
            SET ball = FIND("ball")
            IF ball == NONE THEN
                SET ball = FIND("apple")
            END
            IF ball == NONE THEN
                # ball dropped below the low camera right at our feet — finish
                # the job by driving straight through to the wall
                PRINT "ball is at our feet — pushing straight through to the wall."
                SET r = PUSH_THROUGH(0.7)
                SET done = 1
            ELSE
                SET bx = ball.x
                SET by = ball.y
            END
        END
    END
    PRINT "Done."
ELSE
    PRINT "No ball found in the room."
END
