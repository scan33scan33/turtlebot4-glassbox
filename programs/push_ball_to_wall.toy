# name: push_ball_to_wall
# description: find the ball and push it to the wall
# triggers: push the ball to the wall, push the ball, move the ball to the wall, ball to the wall, clear the ball away
# plan: locate the ball (scan)@SCAN_FOR | look again to lock it@FIND | approach & push the ball@PUSH_AWAY | finish push to the wall@PUSH_THROUGH
#
# Step-and-stare finds and centres the ball. PUSH_AWAY uses the planner only
# when it is far away; close up it follows the LIVE camera bearing for a short
# shove, then stops to re-find it. Only finish blind when PUSH_AWAY has just
# confirmed a centred ball disappearing at our feet. A failed approach or a
# ball escaping to the side must NOT be treated as success or pushed blindly.

SET push_seg = 0.40
SET ball = SCAN_FOR("ball", 360)

IF ball != NONE THEN
    PRINT "Found the ball — getting a fresh fix before pushing."
    WAIT(0.2)
    SET fresh = FIND("ball")
    IF fresh == NONE THEN
        SET fresh = FIND("apple")
    END
    IF fresh != NONE THEN
        SET ball = fresh
    ELSE
        PRINT "Camera flickered; will reacquire before moving."
    END
    SET bx = ball.x
    SET by = ball.y
    SET done = NONE
    SET r = NONE
    SET tries = 0
    WHILE done == NONE AND tries < 14 DO
        SET tries = tries + 1
        SET r = PUSH_AWAY(bx, by, push_seg)
        IF r == "pinned" THEN
            PRINT "Ball pinned against the wall."
            SET done = 1
        ELSE
            IF r == "at-feet" THEN
                PRINT "Ball centred at our feet — finishing straight ahead."
                SET r = PUSH_THROUGH(0.7)
                IF r == "done" THEN
                    PRINT "Finished the short straight push; wall contact was not confirmed."
                END
                SET done = 1
            ELSE
                IF r == "pushed" THEN
                    WAIT(0.3)
                    SET ball = FIND("ball")
                    IF ball == NONE THEN
                        SET ball = FIND("apple")
                    END
                    IF ball == NONE THEN
                        PRINT "Lost the ball after a shove — stopping instead of driving blind."
                        SET r = "lost"
                        SET done = 1
                    ELSE
                        SET bx = ball.x
                        SET by = ball.y
                    END
                ELSE
                    PRINT "Push stopped before reaching the wall:"
                    PRINT r
                    SET done = 1
                END
            END
        END
    END
    IF done == NONE THEN
        PRINT "Stopped after 14 shoves; wall not confirmed."
        SET r = "timeout"
    END
    PRINT "Result:"
    PRINT r
ELSE
    PRINT "No ball found in the room."
END
