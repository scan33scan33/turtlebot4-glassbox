[Unit]
Description=TB4 OAK-D YOLO camera pipeline
After=turtlebot4.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Environment=HOME=/home/ubuntu
WorkingDirectory=/home/ubuntu/Workspace/turtlebot4-glassbox
ExecStart=/bin/bash /home/ubuntu/Workspace/turtlebot4-glassbox/services/tb4-oakd-run.sh
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
