# OAK-D YOLO blobs: NOT committed. They are published as GitHub Release assets
# and fetched by object_detection/download_models.sh — this keeps the clone small and
# avoids redistributing AGPL-3.0-derived Ultralytics weights from an MIT repo
# (see NOTICE). The DEPLOYED blob is a
# properly-preprocessed export: depthai-model-zoo blobs lack the /255 input scale
# and under-detect on-device. Build on a python3.10 box (see ~/blobenv on the Pi):
#   pip install ultralytics blobconverter onnx "tools @ git+https://github.com/luxonis/tools.git"
#   tools yolov8s.pt --imgsz 416   # -> shared_with_container/outputs/<run>/yolov8s.onnx (yolov6r2 head)
#   python -c "import blobconverter,shutil; shutil.copy(blobconverter.from_onnx(\
#     model='<that .onnx>', data_type='FP16', shaves=6, version='2022.1',\
#     optimizer_params=['--scale_values=[255,255,255]','--reverse_input_channels']),\
#     'yolov8s_416_fixed_6shave.blob')"
*.blob
test_dataset/

# regenerable export artifact
object_detection/yolov8s.onnx
